import numpy as np  # Импорт библиотеки NumPy для работы с массивами
import time  # Импорт модуля time для измерения времени выполнения


def print_block(title):
    # Функция для вывода разделителя с заголовком
    print("\n" + "=" * 70)
    print(title)
    print("=" * 70)


def std_py(values):
    # Функция для вычисления стандартного отклонения стандартными средствами Python
    mean_value = sum(values) / len(values)  # Среднее арифметическое
    variance = sum((x - mean_value) ** 2 for x in values) / len(values)  # Дисперсия
    return variance ** 0.5  # Корень из дисперсии = стандартное отклонение


# ==================== Исходные данные ====================
# Создание массивов NumPy
a = np.array([4, 8, 15, 16, 23, 42], dtype=np.int64)  # Одномерный массив int64
b = np.array([
    [3, 7, 11],
    [13, 17, 19],
    [23, 29, 31]
], dtype=np.int64)  # Двумерный массив 3x3

a2 = np.array([1, 2, 3, 4, 5, 6], dtype=np.int64)  # Ещё один одномерный для операций
c = np.array([10, 20, 30], dtype=np.int64)  # Вектор для broadcasting

# Преобразование в списки Python
list_a = a.tolist()  # NumPy -> list
list_b = b.tolist()  # NumPy -> list
list_a2 = a2.tolist()  # NumPy -> list
list_c = c.tolist()  # NumPy -> list
flat_b = [item for row in list_b for item in row]  # Разворачивание списка списков в плоский


