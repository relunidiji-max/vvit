# 7. Изменение типа данных, память и время выполнения
print_block("Задание 7. Тип данных, память и производительность")

float64_arr = np.array([1.25, 2.50, 3.75, 4.00], dtype=np.float64)  # Массив float64
float32_arr = float64_arr.astype(np.float32)  # Явное приведение к float32
int32_arr = float64_arr.astype(np.int32)  # Приведение к int32 (дробная часть отбрасывается)

print("float64:", float64_arr, "sum =", float64_arr.sum(), "nbytes =", float64_arr.nbytes)  # .nbytes — байт памяти
print("float32:", float32_arr, "sum =", float32_arr.sum(), "nbytes =", float32_arr.nbytes)
print("int32:", int32_arr, "sum =", int32_arr.sum(), "nbytes =", int32_arr.nbytes)

N = 1_000_000
large_np = np.arange(N, dtype=np.int64)  # Массив чисел от 0 до N-1
large_list = list(range(N))  # Обычный список Python

start_np = time.perf_counter()  # Начало замера (NumPy)
sum_np = large_np.sum()  # Суммирование методом NumPy
end_np = time.perf_counter()  # Конец замера

start_py = time.perf_counter()  # Начало замера (Python)
sum_py = sum(large_list)  # Суммирование встроенной функцией sum
end_py = time.perf_counter()  # Конец замера

print("\nСравнение скорости суммирования:")
print("NumPy sum:", sum_np, "time =", round(end_np - start_np, 6), "сек.")
print("Python sum:", sum_py, "time =", round(end_py - start_py, 6), "сек.")
print("Результаты суммирования совпадают:", sum_np == sum_py)
