print("Сумма по столбцам, axis=0:", np.sum(b, axis=0))  # Суммирование по вертикали (столбцы)
print("Сумма по строкам, axis=1:", np.sum(b, axis=1))  # Суммирование по горизонтали (строки)
print("Среднее по столбцам, axis=0:", np.mean(b, axis=0))  # Среднее по столбцам
print("Среднее по строкам, axis=1:", np.mean(b, axis=1))  # Среднее по строкам

