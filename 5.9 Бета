print("NumPy для a:")
print("Сумма:", np.sum(a))  # Сумма всех элементов
print("Среднее:", np.mean(a))  # Среднее арифметическое
print("Минимум:", np.min(a))  # Минимальный элемент
print("Максимум:", np.max(a))  # Максимальный элемент
print("Стандартное отклонение:", np.std(a))  # Стандартное отклонение

print("\nNumPy для b:")
print("Сумма:", np.sum(b))  # Сумма всех элементов
print("Среднее:", np.mean(b))  # Среднее всех
print("Минимум:", np.min(b))  # Минимум среди всех
print("Максимум:", np.max(b))  # Максимум среди всех
print("Стандартное отклонение:", np.std(b))  # Стандартное отклонение всех

print("\nПоэлементные операции NumPy:")
print("a + 10 =", a + 10)  # Прибавление скаляра к каждому элементу
print("a + a2 =", a + a2)  # Поэлементное сложение массивов одинаковой длины
print("b * 2 =")
